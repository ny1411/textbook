// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------ Model Setup ------

model User{
  id                    String @id @default(uuid()) @db.Uuid
  name                  String?
  email                 String @unique
  profileImageUrl       String?
  bio                   String?

  notebooks             Notebooks[]
  conversations         Conversations[]
  documents             UploadedDocuments[]
  conceptFigures        ConceptFigures[]
  conceptFigureAttempts ConceptFigureAttempts[]
  chatAttachments       ChatAttachments[]
  artifacts             GeneratedArtifacts[]
  memories              UserMemory[]
  preferences           UserPreferences[]  
  documentDeletions     DocumentDeletions[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("users")
}

model Notebooks{
  id                    String @id @default(uuid()) @db.Uuid
  userId                String @db.Uuid 
  name                  String?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents             UploadedDocuments[]
  conceptFigures        ConceptFigures[]
  chatAttachments       ChatAttachments[]
  conversations         Conversations[]
  artifacts             GeneratedArtifacts[]
  documentDeletions     DocumentDeletions[]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt 

  @@unique([id, userId])
  @@index([userId])
  @@map("notebooks")
}

model UploadedDocuments{
  id                    String @id @default(uuid()) @db.Uuid
  userId                String @db.Uuid
  notebookId            String @db.Uuid

  name                  String?
  fileType              String?
  fileSize              String?
  storageUrl            String?
  
  status                STATUS @default(UPLOADED)
  pageCount             Int?
  sampleKey             String?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook              Notebooks              @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  conversations         ConversationDocuments[]
  messageSources        MessageSources[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([notebookId])
  @@unique([userId, notebookId, sampleKey])
  @@map("uploaded_documents")
}

model Conversations{
  id                    String @id @default(uuid()) @db.Uuid
  userId                String @db.Uuid
  notebookId            String @db.Uuid

  title                 String?
  version               Int @default(0)
  chatAttachments       ChatAttachments[]

  documents             ConversationDocuments[]
  messages              ConversationMessages[]
  artifacts             GeneratedArtifacts[]
  
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook              Notebooks              @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([notebookId])
  @@index([userId, notebookId, updatedAt])
  @@map("conversations")
}

// Durable cleanup intents survive document deletion to authorize safe retries.
model DocumentDeletions {
  documentId            String @id @db.Uuid
  userId                String @db.Uuid
  notebookId            String @db.Uuid
  storagePath           String?
  requestedAt           DateTime @default(now())
  completedAt           DateTime?

  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook              Notebooks @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([userId, notebookId])
  @@map("document_deletions")
}

model ConversationDocuments{
  conversationId        String @db.Uuid
  documentId            String @db.Uuid
  
  conversation          Conversations          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  document              UploadedDocuments      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@id([conversationId, documentId])
  @@index([documentId])
  @@map("conversation_documents")
}

model ConversationMessages{
  id                  String @id @default(uuid()) @db.Uuid
  conversationId      String @db.Uuid

  role                MESSAGEROLES
  message             String?
  sequence            Int
  requestId           String? @db.Uuid
  metadata            Json?

  conversation         Conversations            @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sources             MessageSources[]
  chatAttachments     ChatAttachments[]

  createdAt           DateTime @default(now())
  
  @@index([conversationId, createdAt])
  @@unique([conversationId, sequence])
  @@unique([conversationId, requestId, role])
  @@map("conversation_messages")
}

model MessageSources{
  id                  String @id @default(uuid()) @db.Uuid
  messageId           String @db.Uuid
  documentId          String @db.Uuid
  sourceId            String

  pageNumber          Int?
  chunkRef            String?
  citationText        String?

  message             ConversationMessages     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document            UploadedDocuments        @relation(fields: [documentId], references: [id], onDelete: Cascade)
    
  @@unique([messageId, sourceId])
  @@index([messageId])
  @@index([documentId])
  @@map("message_sources")
}

model ChatAttachments{
  id                    String @id @db.Uuid
  userId                String @db.Uuid
  notebookId            String @db.Uuid
  conversationId        String @db.Uuid
  messageId             String? @db.Uuid
  name                  String
  mediaType             String
  size                  Int
  digest                String
  storagePath           String @unique
  state                 String
  expiresAt             DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook              Notebooks @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  conversation          Conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message               ConversationMessages? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId])
  @@index([expiresAt])
  @@index([messageId])
  @@map("chat_attachments")
}

model GeneratedArtifacts{
  id                  String @id @default(uuid()) @db.Uuid
  userId              String @db.Uuid
  notebookId          String @db.Uuid
  conversationId      String @db.Uuid

  type                DOCUMENTTYPE
  title               String?

  content             String?
  storageUrl          String?

  status              STATUS @default(PROCESSING)

  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook            Notebooks                @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  conversation        Conversations            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([notebookId])
  @@index([conversationId])
  @@map("generated_artifacts")
}

model UserMemory{
  id                  String @id @default(uuid()) @db.Uuid
  userId              String @db.Uuid
  notebookId          String?
  memoryText          String?
  memoryType          String?

  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UserPreferences{
  id                  String @id @default(uuid()) @db.Uuid
  userId              String @db.Uuid
  defaultLLM          String?

  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ------ ENUMS ------

enum STATUS{
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum MESSAGEROLES{
  USER
  LLM
  SYSTEM
}

enum DOCUMENTTYPE{
  IMAGE
  VIDEO
  PDF
  WORD
  CSV
  EXCEL
  PRESENTATION
}

// Private, durable generated diagrams; source is a deletion-safe snapshot.
model ConceptFigures {
  id             String @id @db.Uuid
  userId         String @db.Uuid
  notebookId     String @db.Uuid
  prompt         String
  caption        String
  mediaType      String @default("image/png")
  width          Int?
  height         Int?
  size           Int @default(0)
  digest         String?
  model          String
  source         Json?
  storagePath    String @unique
  state          String
  expiresAt      DateTime? @db.Timestamptz(6)
  uploadedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook       Notebooks @relation(fields: [notebookId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, notebookId])
  @@index([expiresAt])
  @@map("concept_figures")
}

model ConceptFigureAttempts {
  id             String @id @db.Uuid
  userId         String @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("concept_figure_attempts")
}
