# Copy to .env.local for development; configure Preview/Production in Vercel.
# Local FastAPI origin. On Vercel, use the live HTTPS origin without /api.
BACKEND_URL=http://127.0.0.1:8000

# Public browser configuration from the intended Supabase project's API settings.
# Use the anon/publishable key, never SUPABASE_SECRET_KEY or a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
